# Flag values for the Northwind Supply Co. challenges.
#
# Copy to .env and replace every value before deploying, or set the same names
# as Vercel environment variables. The values below are PLACEHOLDERS and are
# deliberately not the ones running in production: the production targets are
# publicly reachable, so a flag committed to this repository would be a flag
# disclosed to the internet.
#
# dev-up.sh generates a .env with random flag values if none exists, so a fresh
# clone runs unattended without publishing anything.
#
# Format: G24{...} containing only letters, digits and underscores.

FLAG_JWT=G24{set_a_unique_value_per_deployment}
FLAG_SQLI=G24{set_a_unique_value_per_deployment}
FLAG_XSS=G24{set_a_unique_value_per_deployment}
FLAG_KID=G24{set_a_unique_value_per_deployment}

# Challenge 04 reads signing keys from this directory using the token's `kid`.
# The value must end in a path separator.
KEY_DIR=./keys/
KEY_ID=key-2026-01.key

# HS256 signing key for challenges 01 to 03.
JWT_SECRET=set-a-long-random-value-per-deployment
